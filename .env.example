# Cloudflare control plane (used by provision / Slack manifest rendering)
WORKER_BASE_URL=https://qali-slack-control.<your-subdomain>.workers.dev

# Slack control plane (Cloudflare Worker secrets)
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=
SLACK_BOT_USER_ID=
SLACK_ALLOWED_TEAM_IDS=
SLACK_ALLOWED_CHANNEL_IDS=
SLACK_ALLOWED_USER_IDS=
SLACK_QA_LEAD_USER_IDS=

# GitHub App — workflow dispatch (read + actions:write)
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_INSTALLATION_ID=
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_WORKFLOW_FILE=execute.yml
GITHUB_REF=main
GITHUB_WEBHOOK_SECRET=

# GitHub App — controlled publication (contents:write, pull_requests:write)
QALI_PUBLISH_GITHUB_TOKEN=

# Optional live Cursor Agent (also set as Actions var/secret for CI)
CURSOR_MODEL=
CURSOR_API_KEY=
QALI_PROVENANCE_REF=
QALI_AUTHORITY_REF=
