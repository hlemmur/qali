# Cloudflare control plane (used by provision / Slack manifest rendering)
WORKER_BASE_URL=https://qali-slack-control.<your-subdomain>.workers.dev

# Slack control plane (Cloudflare Worker secrets)
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=
SLACK_BOT_USER_ID=
SLACK_ALLOWED_TEAM_IDS=
SLACK_ALLOWED_CHANNEL_IDS=
SLACK_ALLOWED_USER_IDS=
SLACK_QA_LEAD_USER_IDS=
SLACK_OPS_CHANNEL_IDS=

# GitHub App — workflow dispatch (read + actions:write)
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_INSTALLATION_ID=
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_WORKFLOW_FILE=execute.yml
GITHUB_REF=main
GITHUB_WEBHOOK_SECRET=

# GitHub App — controlled publication (contents:write, pull_requests:write)
QALI_PUBLISH_GITHUB_TOKEN=

# Optional live Cursor Agent (synced to GitHub Actions by control-plane:sync-secrets)
CURSOR_MODEL=composer-2.5
CURSOR_API_KEY=
# JSON array ordered by failover preference; unattended runs still require an
# active exact-match record in qualification/registry.json.
QALI_CURSOR_FAILOVER_MODELS_JSON=[]
QALI_PROVENANCE_REF=
QALI_AUTHORITY_REF=

# Project GitHub Environment (for example, qali-sauce-demo). With multiple
# registered projects, use a project-scoped env file plus --project <id>
# when syncing. These standard names are consumed by every execution profile.
QALI_TARGET_BASE_URL=https://www.saucedemo.com
QALI_ALLOWED_ORIGINS_JSON=["https://www.saucedemo.com"]
# Named credentials only. Username belongs in QALI_TEST_DATA_JSON.
# Add named credential `password` in the GitHub Environment secret; never commit the value.
QALI_TEST_CREDENTIALS_JSON={}
QALI_TEST_DATA_JSON={"username":"standard_user"}
