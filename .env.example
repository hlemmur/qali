# Local development configuration
# For deployment, these are set via Terraform / the deploy command.

# Private development uses the Gemini Developer API free tier.
# Use only non-sensitive test data: free-tier content may be used by Google
# to improve its products. Never commit a populated .env file.
GOOGLE_GENAI_USE_VERTEXAI=false
GEMINI_API_KEY=your-api-key-here

# Qali's GCP resources use the approved project and region. These values do
# not switch model traffic to paid Vertex AI while the flag above is false.
GOOGLE_CLOUD_PROJECT=qali-507317
GOOGLE_CLOUD_LOCATION=europe-west1
