# Local development configuration
# For deployment, these are set via Terraform / the deploy command.

# Private development uses the Gemini Developer API free tier.
# Use only non-sensitive test data: free-tier content may be used by Google
# to improve its products. Never commit a populated .env file.
GOOGLE_GENAI_USE_VERTEXAI=false
GEMINI_API_KEY=your-api-key-here

# Qali's GCP resources use the approved project and region. These values do
# not switch model traffic to paid Vertex AI while the flag above is false.
GOOGLE_CLOUD_PROJECT=qali-507317
GOOGLE_CLOUD_LOCATION=europe-west1

# The standalone Slack ingress requires an explicit runtime mode. Mock mode uses
# only local in-memory adapters and displays a visible badge.
QALI_MODE=mock
SLACK_SIGNING_SECRET=mock-slack-signing-secret
SLACK_WORKSPACE_ID=T-MOCK-QALI
SLACK_CHANNEL_ID=C-MOCK-QALI
SLACK_OWNER_USER_ID=U-MOCK-OWNER

# Live ingress configuration is injected by the deployment environment. Do not
# uncomment these with real secrets in a committed file. QALI_MODE=live requires
# every value below and uses Application Default Credentials for Google Cloud.
# SLACK_SIGNING_SECRET=inject-from-secret-manager
# SLACK_WORKSPACE_ID=T-PRODUCTION
# SLACK_CHANNEL_ID=C-PRODUCTION
# SLACK_OWNER_USER_ID=U-OWNER
# FIRESTORE_DATABASE_ID=(default)
# FIRESTORE_JOBS_COLLECTION=jobs
# FIRESTORE_JOB_LOCKS_COLLECTION=job-locks
# FIRESTORE_JOB_LEASE_SECONDS=960
# CLOUD_TASKS_LOCATION=europe-west1
# CLOUD_TASKS_QUEUE_ID=qali-jobs
# QALI_WORKER_URL=https://worker-service-url/internal/jobs
# QALI_WORKER_OIDC_AUDIENCE=https://worker-service-url
# QALI_FEATURE_WORKER_URL=https://feature-worker-service-url/internal/feature-jobs
# QALI_FEATURE_WORKER_OIDC_AUDIENCE=https://feature-worker-service-url
# QALI_TASKS_SERVICE_ACCOUNT_EMAIL=qali-tasks@qali-507317.iam.gserviceaccount.com

# The onboarding worker uses the same QALI_MODE=live, free-tier model settings,
# project, Firestore database, job collections, and queue ID. Every remaining
# value below is also required before it creates any production adapter.
# FIRESTORE_PROJECTS_COLLECTION=projects
# FIRESTORE_SOURCES_COLLECTION=sources
# GCS_ARTIFACTS_BUCKET=qali-private-artifacts
# GCS_TIMEOUT_SECONDS=60
# SLACK_BOT_TOKEN=inject-from-secret-manager
# SLACK_API_TIMEOUT_SECONDS=30
# QALI_ALLOWED_ORIGINS=https://app.example.test,https://docs.example.test
# QALI_SOURCE_MAX_BYTES=5000000
# QALI_SOURCE_MAX_REDIRECTS=3
# QALI_SOURCE_TIMEOUT_SECONDS=30
# QALI_SOURCE_MAX_SOURCES=10
# CLAMAV_EXECUTABLE=clamscan
# CLAMAV_TIMEOUT_SECONDS=30
# CLAMAV_SCANNER_ID=clamav-engine-and-signature-version
# QALI_JOB_TIMEOUT_SECONDS=900
# QALI_JOB_MAX_DELIVERY_ATTEMPTS=3
# QALI_BROWSER_TARGET_POLICY_JSON={"project_id":"slack-project-channel-hash","start_url":"https://app.example.test","allowed_origins":["https://app.example.test"],"allowed_actions":["navigate","snapshot","click_ref","type_text","observe_oracle","capture_evidence"],"credential_references":[],"safe_consequential_actions":[],"max_steps":20,"timeout_seconds":300}

# The production feature worker and browser attempt runner additionally require an
# isolated local MCP output root and a bounded Secret Manager access timeout. They
# reuse the live mode, free-tier model, GCP project, artifact bucket, GCS timeout,
# Firestore lifecycle, queue, and Slack token values above.
# PLAYWRIGHT_MCP_OUTPUT_ROOT=/tmp/qali-browser
# SECRET_MANAGER_TIMEOUT_SECONDS=30
