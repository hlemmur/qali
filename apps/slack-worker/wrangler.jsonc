{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "qali-slack-control",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-10",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "qali-control",
      "database_id": "4873e551-f0d6-4dcf-ac3b-4c91edbb8f4c",
      "migrations_dir": "migrations"
    }
  ],
  "queues": {
    "producers": [{ "binding": "INBOUND_QUEUE", "queue": "qali-inbound" }],
    "consumers": [{ "queue": "qali-inbound", "max_batch_size": 10, "max_batch_timeout": 5 }]
  },
  "vars": {
    "GITHUB_API_URL": "https://api.github.com",
    "GITHUB_WORKFLOW_FILE": "execute.yml",
    "SLACK_ALLOWED_TEAM_IDS": "",
    "SLACK_ALLOWED_CHANNEL_IDS": "",
    "SLACK_ALLOWED_USER_IDS": "U099MTX6423",
    "SLACK_QA_LEAD_USER_IDS": "U099MTX6423"
  },
  "ai": {
    "binding": "AI"
  }
}
