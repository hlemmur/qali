{
  "version": 1,
  "id": "{{PROJECT_ID}}-staging",
  "projectId": "{{PROJECT_ID}}",
  "environmentLabel": "staging",
  "targetVariables": {
    "baseUrl": "QALI_TARGET_BASE_URL",
    "allowedOrigins": "QALI_ALLOWED_ORIGINS_JSON",
    "credentials": "QALI_TEST_CREDENTIALS_JSON",
    "testData": "QALI_TEST_DATA_JSON"
  },
  "browser": {
    "name": "chromium",
    "allowDownloads": false,
    "allowPopups": false,
    "allowedSubmissions": []
  },
  "rate": {
    "maxActionsPerMinute": 60
  },
  "mutation": {
    "allowed": ["append-observation", "append-evidence", "render-derived-report"]
  },
  "cleanup": {
    "strategy": "fixture-reset"
  },
  "redaction": {
    "patterns": []
  },
  "retention": {
    "evidenceDays": 14
  },
  "publication": {
    "reviewOnly": true
  }
}
