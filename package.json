{
  "name": "qali",
  "version": "0.1.0",
  "description": "Slack-first autonomous QA orchestration with Playwright as deterministic truth.",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "tsc --noEmit",
    "check": "npm run format:check && npm run lint && npm run build && npm run registry:validate && npm test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "vitest run --exclude \"projects/**/tests/**/*.spec.ts\"",
    "test:watch": "vitest",
    "demo:test": "QALI_TARGET_BASE_URL=http://127.0.0.1:4173 QALI_WEB_SERVER_COMMAND='node projects/_demo/app/server.mjs' QALI_WEB_SERVER_URL=http://127.0.0.1:4173/health playwright test projects/_demo/tests",
    "demo:loop": "tsx scripts/demo-loop.ts",
    "execute": "tsx scripts/execute.ts",
    "browser:mcp": "tsx scripts/browser-facade-mcp.ts",
    "post:run-summary": "tsx scripts/post-run-summary.ts",
    "publish:prepare": "tsx scripts/prepare-publication.ts",
    "publish": "tsx scripts/publish.ts",
    "project:validate": "tsx scripts/validate-project.ts",
    "registry:validate": "node --import tsx scripts/validate-project-registry.ts",
    "control-plane:provision": "tsx scripts/provision-control-plane.ts",
    "control-plane:render-slack-manifest": "QALI_RENDER_SLACK_MANIFEST=1 tsx scripts/provision-control-plane.ts",
    "control-plane:sync-secrets": "tsx scripts/sync-worker-secrets.ts",
    "control-plane:deploy": "npm exec -- wrangler deploy --config apps/slack-worker/wrangler.jsonc",
    "control-plane:dry-run": "npm exec -- wrangler deploy --dry-run --config apps/slack-worker/wrangler.jsonc",
    "control-plane:dev": "npm exec -- wrangler dev --config apps/slack-worker/wrangler.jsonc"
  },
  "keywords": [
    "qa",
    "playwright",
    "slack",
    "agent"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "eslint": "^10.8.1",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  }
}
